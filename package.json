{
  "name": "jest-mock-axios",
  "version": "4.10.0",
  "description": "Axios mock for Jest",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    "import": "./dist/index.mjs",
    "require": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "scripts": {
    "clean": "rimraf ./dist",
    "lint": "oxlint lib test",
    "format": "oxfmt lib test",
    "format:check": "oxfmt --check lib test",
    "prepare": "husky",
    "type-check": "tsc --noEmit",
    "type-check:watch": "npm run type-check -- --watch",
    "build": "tsdown lib/index.ts --format cjs,esm --dts --clean",
    "deploy2npm": "npm run build && npm publish",
    "test": "jest --watch",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/knee-cola/jest-mock-axios.git"
  },
  "keywords": [
    "axios",
    "jest",
    "mock"
  ],
  "author": "knee-cola <nikola.derezic@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/knee-cola/jest-mock-axios/issues"
  },
  "homepage": "https://github.com/knee-cola/jest-mock-axios#readme",
  "devDependencies": {
    "@types/jest": "~30.0.0",
    "cross-env": "^10.0.0",
    "husky": "^9.1.7",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.4.15",
    "tsdown": "0.22.14",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@jest/globals": "^30.5.1",
    "jest": "^30.5.1",
    "synchronous-promise": "^2.0.18"
  }
}
